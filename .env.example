# Copy to .env. Do not commit secrets.
DATABASE_URL="postgresql://profe:profe_dev_password@localhost:5432/mi_profe?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="1d"
# Use Gemini (free tier) or OpenAI. If GEMINI_API_KEY is set, it takes priority.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
BOOTSTRAP_EMAIL="micaela@example.com"
BOOTSTRAP_PASSWORD="change-this-password-now"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASIER
  NORMAL
  HARDER
}

enum Accent {
  EN_US
  EN_GB
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum ErrorCategory {
  final_sounds
  contractions
  weak_forms
  linking
  numbers
  unknown_vocab
  spelling
  verb_tense
  articles
  prepositions
  word_order
  word_choice
}

enum SessionType {
  LESSON
  REVIEW
  SPEAKING
  CONVERSATION
  ASSESSMENT
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum LessonType {
  LISTENING
  KEY_WORDS
  SAY_THE_PHRASE
  CONVERSATION
}

enum ExerciseType {
  LISTEN_CHOICE
  DICTATION
  FILL_GAP
  WORD_ORDER
  VOCABULARY
  SPEAK_ALOUD
}

enum TtsStatus {
  PENDING
  READY
  FAILED
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  profile        Profile?
  settings       Settings?
  weaknesses     Weakness[]
  classNotes     ClassNote[]
  sessions       Session[]
  lessonProgress LessonProgress[]
  dailyXp        DailyXp[]
  achievements   UserAchievement[]
  assessments    OnboardingAssessment[]
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  cefrLevel            String   @default("A2")
  interests            String[] @default([])
  goal                 String   @default("Speak English more fluently and understand spoken English.")
  onboardingCompleted  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id            String     @id @default(cuid())
  userId        String     @unique
  dailyGoalXp   Int        @default(50)
  difficulty    Difficulty @default(NORMAL)
  accent        Accent     @default(EN_US)
  voice         String     @default("alloy")
  speechSpeed   Float      @default(1.0)
  theme         Theme      @default(SYSTEM)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Weakness {
  id             String        @id @default(cuid())
  userId         String
  category       ErrorCategory
  count          Int           @default(0)
  lastOccurredAt DateTime?
  examples       Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId, count])
}

model ClassNote {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  topics    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id               String        @id @default(cuid())
  userId           String
  type             SessionType
  status           SessionStatus @default(IN_PROGRESS)
  unitId           String?
  lessonType       LessonType?
  score            Float?
  accuracy         Float?
  xpEarned         Int           @default(0)
  summary          String?
  focusCategories  ErrorCategory[] @default([])
  difficultyFeedback String?
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises        Exercise[]
  turns            ConversationTurn[]

  @@index([userId, startedAt])
}

model Exercise {
  id              String       @id @default(cuid())
  sessionId       String
  order           Int
  type            ExerciseType
  instruction     String
  englishText     String
  translation     String
  tip             String
  focusCategory   ErrorCategory?
  options         Json?
  correctAnswer   Json
  metadata        Json         @default("{}")
  session         Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempts        ExerciseAttempt[]

  @@unique([sessionId, order])
}

model ExerciseAttempt {
  id            String   @id @default(cuid())
  exerciseId    String
  attemptNumber Int
  answer        Json
  isCorrect     Boolean
  transcript    String?
  xpAwarded     Int      @default(0)
  createdAt     DateTime @default(now())
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, attemptNumber])
  @@index([exerciseId, createdAt])
}

model LessonProgress {
  id            String     @id @default(cuid())
  userId        String
  unitId        String
  lessonType    LessonType
  unlocked      Boolean    @default(false)
  completedAt   DateTime?
  bestAccuracy  Float?
  stars         Int        @default(0)
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId, lessonType])
  @@index([userId, unlocked])
}

model DailyXp {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  xp        Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String
  icon        String
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model TtsCache {
  id          String    @id @default(cuid())
  hash        String    @unique
  text        String
  voice       String
  accent      Accent
  speed       Float
  model       String
  storageKey  String?
  status      TtsStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ConversationTurn {
  id            String   @id @default(cuid())
  sessionId     String
  sequence      Int
  role          String
  content       String
  transcript    String?
  correction    Json?
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
}

model OnboardingAssessment {
  id          String   @id @default(cuid())
  userId      String
  answers     Json     @default("[]")
  estimatedLevel String?
  confidence  String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
